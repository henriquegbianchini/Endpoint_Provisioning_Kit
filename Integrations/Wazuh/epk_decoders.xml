<!-- Copy to /var/ossec/etc/decoders/epk_decoders.xml on your LAB manager. -->
<decoder name="epk-log">
  <prematch type="pcre2">^\[\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\] \[(?:OK|RUN|TODO|WRN|ERR)\] \[[A-Z]+-\d+\]</prematch>
</decoder>

<decoder name="epk-log">
  <parent>epk-log</parent>
  <regex type="pcre2">^\[[^\]]+\] \[(OK|RUN|TODO|WRN|ERR)\] \[([A-Z]+-\d+)\] (.*)$</regex>
  <order>epk.level,epk.code,epk.message</order>
</decoder>
