# Copy this to .env (which is Git-ignored), then replace BOTH passwords.
# Example only: choose long, unique secrets.
NOC_POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_DB_PASSWORD
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_RANDOM_GRAFANA_PASSWORD

# Safest default: localhost only, accessed using an SSH tunnel.
# Change to the isolated lab VM address (e.g. 10.77.0.30) ONLY if
# a host firewall and private VM network are in place.
NOC_WEB_BIND_IP=127.0.0.1

# Bind to 10.77.0.30 if Windows/Linux clients use Zabbix active checks.
# Can remain 127.0.0.1 for passive agents queried by Zabbix server.
NOC_AGENT_BIND_IP=127.0.0.1
